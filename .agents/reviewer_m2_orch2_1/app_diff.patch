+        let active = app.active_session();
+        assert!(
+            active.focus_composer,
+            "newly created session initializes with keyboard focus requested"
+        );
+        assert!(
+            !active.has_folder(),
+            "new session starts without a project folder"
+        );
+    }
+
+    #[test]
